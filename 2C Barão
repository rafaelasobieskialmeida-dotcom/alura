CSS
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}




body {
    font-family: Arial, sans-serif;
    background-color: #f5f7ff;        
    color: #222;
}




header {
    display: flex;
    justify-content: space-between;
    align-items: center;


    padding: 05px 8%;                    /*  Altere o padding de 05px para 25px */


    background-color: rgb(3, 16, 51);           /* Altere a cor do background-color */
}




header h2 {
    color: #dde1ee;
    font-size: 10px;         /* Altere o font- size de 10px para 24px */
}




nav {
    display: flex;
    gap: 30px;
}




nav a {
    text-decoration: none;
    color: #4e577e;
    font-size: 16px;
}




nav a:hover {
    color: #3155d9;   /* Altere a cor do color */    
}




/* HERO */


#inicio {
    min-height: 600px;                


    padding: 70px 8%;                 /* Altere o padding de 70 px para 100px */


    display: flex;
    align-items: center;
    justify-content: space-between;


    gap: 60px;


    background-color: #f5f7ff;           /* Altere a cor do background-color */
}




.hero-text {
    width: 50%;
}




#inicio h1 {
    font-size: 30px;             /* Altere o tamanho do font-size de 30px para 60px */
    line-height: 1.1;


    max-width: 600px;


    margin-bottom: 20px;
}




#inicio span {
    color: #3155d9;
}




#inicio p {
    font-size: 12px;              /* Altere o tamanho do font-size de 12px para 18px */


    line-height: 1.7;


    max-width: 520px;


    margin-bottom: 30px;
}




#inicio a {
    display: inline-block;


    background-color: #3155d9;    /* Altere a cor do background-color */


    color: white;


    padding: 15px 30px;             /* Altere o padding de 30px para 80px */


    text-decoration: none;


    border-radius: 8px;


    transition: 0.3s;
}




#inicio a:hover {
    background-color: #1d328c;    /*  Altere a cor do background-color */


    transform: translateY(-2px);
}




#inicio img {
    width: 18%;          /* Altere o  width de 18% para 42% */      


    height: 420px;


    object-fit: cover;


    display: block;


    border-radius: 24px;


    box-shadow:
        0 20px 40px rgba(0, 0, 0, 0.15);
}




/* SEGUNDA SEÇÃO */


#sobre {
    padding: 80px 8%;


    background-color: white;       /* Altere a cor do background-color */


    text-align: left;         /* Altere o text-align de left para center*/    
}




#sobre h2 {
    font-size: 20px;        /* Altere o tamanho do font-size de 20px para 45px */


    margin-bottom: 20px;
}




#sobre > p {
    max-width: 700px;


    margin: 0 auto;


    font-size: 17px;


    line-height: 1.6;
}




#sobre h3 {
    color: #3155d9;


    margin-top: 15px;      /* Altere o tamanho do margin-top de 15px para 50px */


    margin-bottom: 10px;
}




#sobre h3 + p {
    line-height: 1.6;
}




/* CELULAR */


@media (max-width: 800px) {


    #inicio {
        flex-direction: column;


        text-align: center;


        padding: 60px 8%;
    }




    .hero-text {
        width: 100%;
    }




    #inicio h1 {
        font-size: 42px;
    }




    #inicio p {
        margin-left: auto;


        margin-right: auto;
    }




    #inicio img {
        width: 100%;


        height: 300px;
    }


}



