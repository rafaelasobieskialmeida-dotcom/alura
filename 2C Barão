CSS
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #000000;
    color: #D4AF37;
}

/* CABEÇALHO */

header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 25px 8%;

    background-color: #000000;
    border-bottom: 1px solid #D4AF37;
}

header h2 {
    color: #D4AF37;
    font-size: 24px;
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    text-decoration: none;
    color: #D4AF37;
    font-size: 18px;
}

nav a:hover {
    color: #FFD700;
}

/* HERO */

#inicio {
    min-height: 600px;

    padding: 100px 8%;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;

    background-color: #000000;
}

.hero-text {
    width: 50%;
}

#inicio h1 {
    font-size: 60px;
    line-height: 1.1;

    max-width: 600px;

    margin-bottom: 20px;

    color: #D4AF37;
}

#inicio span {
    color: #FFD700;
}

#inicio p {
    font-size: 18px;

    line-height: 1.7;

    max-width: 520px;

    margin-bottom: 30px;

    color: #D4AF37;
}

#inicio a {
    display: inline-block;

    background-color: #D4AF37;

    color: #000000;

    padding: 18px 35px;

    font-size: 18px;
    font-weight: bold;

    text-decoration: none;

    border-radius: 8px;

    transition: 0.3s;
}

#inicio a:hover {
    background-color: #FFD700;

    transform: translateY(-2px);
}

#inicio img {
    width: 42%;

    height: 420px;

    object-fit: cover;

    display: block;

    border-radius: 24px;

    box-shadow:
        0 20px 40px rgba(212, 175, 55, 0.25);
}

/* SEGUNDA SEÇÃO */

#sobre {
    padding: 80px 8%;

    background-color: #000000;

    color: #D4AF37;

    text-align: center;

    border-top: 1px solid #D4AF37;
}

#sobre h2 {
    font-size: 45px;

    margin-bottom: 20px;

    color: #D4AF37;
}

#sobre > p {
    max-width: 700px;

    margin: 0 auto;

    font-size: 18px;

    line-height: 1.6;

    color: #D4AF37;
}

#sobre h3 {
    color: #FFD700;

    font-size: 28px;

    margin-top: 50px;

    margin-bottom: 10px;
}

#sobre h3 + p {
    line-height: 1.6;

    font-size: 18px;

    color: #D4AF37;
}

/* CELULAR */

@media (max-width: 800px) {

    #inicio {
        flex-direction: column;

        text-align: center;

        padding: 60px 8%;
    }

    .hero-text {
        width: 100%;
    }

    #inicio h1 {
        font-size: 42px;
    }

    #inicio p {
        margin-left: auto;

        margin-right: auto;
    }

    #inicio img {
        width: 100%;

        height: 300px;
    }

    nav {
        gap: 15px;
    }

    nav a {
        font-size: 16px;
    }
}
