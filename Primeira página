CSS
/* =========================================
   IDENTIDADE VISUAL — VERSÃO REFINADA
   Paleta: azul profundo + azul vivo + branco
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', 'Poppins', Arial, sans-serif;
    background-color: #f7f9fc;
    color: #172033;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
}

img {
    max-width: 100%;
    height: auto;
}

a {
    color: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

:focus-visible {
    outline: 3px solid #4f8cff;
    outline-offset: 3px;
}

/* =========================================
   HEADER
========================================= */

header {
    min-height: 80px;
    padding: 0 10%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    background-color: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid #e4e9f2;
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
}

.logo {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 0;
    color: #173b8f;
    white-space: nowrap;
}

nav {
    display: flex;
    align-items: center;
    gap: 42px;
}

nav a {
    text-decoration: none;
    color: #344054;
    font-size: 15px;
    font-weight: 600;
    transition: color 0.25s ease, transform 0.25s ease;
}

nav a:hover {
    color: #2563eb;
    transform: translateY(-1px);
}

.header-button {
    text-decoration: none;
    color: #ffffff;
    background-color: #173b8f;
    padding: 11px 22px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 700;
    transition: background-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 8px 20px rgba(23, 59, 143, 0.18);
}

.header-button:hover {
    background-color: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(37, 99, 235, 0.25);
}

/* =========================================
   HERO
========================================= */

.hero {
    min-height: 820px;
    padding: 110px 10%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 90px;
    background: linear-gradient(135deg, #f7f9fc 0%, #eef4ff 100%);
}

.hero-content {
    width: 48%;
    max-width: 650px;
}

.eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #2563eb;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: clamp(52px, 6vw, 76px);
    line-height: 1.04;
    letter-spacing: -3px;
    font-weight: 800;
    margin-bottom: 28px;
    color: #173b8f;
}

.hero h1 span {
    color: #344054;
}

.hero-description {
    max-width: 560px;
    font-size: 18px;
    line-height: 1.8;
    color: #526071;
    margin-bottom: 38px;
}

/* =========================================
   BOTÕES DO HERO
========================================= */

.hero-buttons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
}

.button-primary {
    display: inline-block;
    padding: 17px 30px;
    background-color: #173b8f;
    color: #ffffff;
    text-decoration: none;
    border-radius: 35px;
    font-size: 15px;
    font-weight: 700;
    transition: background-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 10px 25px rgba(23, 59, 143, 0.2);
}

.button-primary:hover {
    background-color: #2563eb;
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(37, 99, 235, 0.25);
}

.button-secondary {
    color: #173b8f;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    padding: 12px 6px;
    transition: color 0.25s ease, transform 0.25s ease;
}

.button-secondary:hover {
    color: #2563eb;
    transform: translateX(3px);
}

/* =========================================
   IMAGEM DO HERO
========================================= */

.hero-image {
    width: 48%;
}

.hero-image img {
    width: 100%;
    height: 580px;
    object-fit: cover;
    object-position: center;
    border-radius: 40px;
    display: block;
    box-shadow: 0 25px 70px rgba(23, 59, 143, 0.16);
    transition: transform 0.5s ease, box-shadow 0.5s ease;
}

.hero-image img:hover {
    transform: scale(1.025);
    box-shadow: 0 30px 80px rgba(23, 59, 143, 0.22);
}

/* =========================================
   SHOWCASE
========================================= */

.showcase {
    padding: 150px 10%;
    background-color: #ffffff;
    text-align: center;
}

.showcase h2 {
    font-size: clamp(42px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -2px;
    margin-bottom: 24px;
    color: #172033;
    font-weight: 800;
}

.showcase h2 span {
    color: #2563eb;
}

.section-description {
    max-width: 680px;
    margin: 0 auto 65px;
    color: #526071;
    font-size: 17px;
    line-height: 1.8;
}

.showcase-image {
    max-width: 1200px;
    margin: auto;
}

.showcase-image img {
    width: 100%;
    height: 650px;
    object-fit: cover;
    object-position: center;
    border-radius: 32px;
    display: block;
    box-shadow: 0 30px 80px rgba(23, 32, 51, 0.14);
}

/* =========================================
   RECURSOS
========================================= */

.features {
    padding: 140px 10%;
    background-color: #f2f6fc;
}

.section-heading {
    max-width: 700px;
    margin-bottom: 65px;
}

.section-heading h2 {
    font-size: clamp(42px, 5vw, 58px);
    line-height: 1.05;
    letter-spacing: -2px;
    color: #172033;
    font-weight: 800;
}

/* =========================================
   GRID DOS CARDS
========================================= */

.feature-grid {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

/* =========================================
   CARDS
========================================= */

.feature-card {
    background-color: #ffffff;
    color: #172033;
    padding: 45px;
    min-height: 350px;
    border: 1px solid #e3eaf4;
    border-radius: 35px;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
}

.feature-card:hover {
    transform: translateY(-12px);
    border-color: #c8d8f5;
    box-shadow: 0 25px 60px rgba(23, 59, 143, 0.12);
}

.feature-number {
    display: block;
    font-size: 13px;
    font-weight: 800;
    color: #2563eb;
    margin-bottom: 85px;
    letter-spacing: 1px;
}

.feature-card h3 {
    font-size: 30px;
    color: #172033;
    margin-bottom: 18px;
    line-height: 1.2;
    font-weight: 800;
}

.feature-card p {
    color: #526071;
    line-height: 1.9;
    font-size: 16px;
}

/* =========================================
   EXPERIENCE
========================================= */

.experience {
    min-height: 700px;
    display: flex;
    align-items: center;
    gap: 100px;
    padding: 120px 10%;
    background: #10234f;
    color: #ffffff;
}

.experience-image {
    width: 50%;
}

.experience-image img {
    width: 100%;
    height: 580px;
    object-fit: cover;
    object-position: center;
    border-radius: 35px;
    display: block;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
}

.experience-content {
    width: 40%;
    max-width: 500px;
}

.experience-content .eyebrow {
    color: #9fc1ff;
}

.experience-content h2 {
    font-size: clamp(44px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -2px;
    margin-bottom: 28px;
    font-weight: 800;
}

.experience-content p {
    color: #d8e3f7;
    line-height: 1.8;
    font-size: 17px;
    margin-bottom: 30px;
}

.text-link {
    display: inline-block;
    color: #9fc1ff;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    transition: color 0.25s ease, transform 0.25s ease;
}

.text-link:hover {
    color: #ffffff;
    transform: translateX(4px);
}

/* =========================================
   SOBRE
========================================= */

.about {
    padding: 160px 10%;
    text-align: center;
    background-color: #ffffff;
}

.about h2 {
    font-size: clamp(48px, 5.5vw, 70px);
    line-height: 1.05;
    letter-spacing: -3px;
    margin-bottom: 32px;
    color: #172033;
    font-weight: 800;
}

.about-description {
    max-width: 720px;
    margin: auto;
    color: #526071;
    font-size: 18px;
    line-height: 1.8;
}

/* =========================================
   CTA
========================================= */

.cta {
    padding: 150px 10%;
    background: linear-gradient(135deg, #eef4ff 0%, #f7f9fc 100%);
    text-align: center;
}

.cta h2 {
    font-size: clamp(44px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -2px;
    max-width: 720px;
    margin: 0 auto 40px;
    color: #172033;
    font-weight: 800;
}

/* =========================================
   FOOTER
========================================= */

footer {
    padding: 50px 10%;
    background-color: #11057ee7;
    border-top: 1px solid #083c81;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    color: #aadbe4;
    font-size: 13px;
}

.footer-logo {
    color: #ffffff;
    font-weight: 800;
    font-size: 19px;
}

.footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
}

.footer-links a {
    color: #b8c5dd;
    text-decoration: none;
    transition: color 0.25s ease;
}

.footer-links a:hover {
    color: #ffffff;
}

/* =========================================
   RESPONSIVIDADE — TABLET
========================================= */

@media (max-width: 1100px) {
    header,
    .hero,
    .showcase,
    .features,
    .experience,
    .about,
    .cta,
    footer {
        padding-left: 6%;
        padding-right: 6%;
    }

    nav {
        gap: 25px;
    }

    .hero {
        gap: 55px;
    }

    .feature-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* =========================================
   RESPONSIVIDADE — CELULAR
========================================= */

@media (max-width: 900px) {
    header {
        min-height: 72px;
    }

    nav {
        display: none;
    }

    .hero {
        min-height: auto;
        flex-direction: column;
        text-align: center;
        padding-top: 85px;
        padding-bottom: 85px;
        gap: 55px;
    }

    .hero-content,
    .hero-image,
    .experience-image,
    .experience-content {
        width: 100%;
        max-width: 100%;
    }

    .hero h1 {
        font-size: clamp(46px, 11vw, 62px);
        letter-spacing: -2px;
    }

    .hero-description {
        margin-left: auto;
        margin-right: auto;
        font-size: 17px;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-image img {
        height: 430px;
    }

    .showcase,
    .features,
    .about,
    .cta {
        padding-top: 100px;
        padding-bottom: 100px;
    }

    .showcase-image img {
        height: 420px;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }

    .feature-card {
        min-height: auto;
    }

    .experience {
        flex-direction: column;
        padding-top: 90px;
        padding-bottom: 90px;
        gap: 55px;
    }

    .experience-content {
        text-align: center;
    }

    .experience-image img {
        height: 430px;
    }

    footer {
        flex-direction: column;
        text-align: center;
    }

    .footer-links {
        justify-content: center;
    }
}

/* =========================================
   RESPONSIVIDADE — CELULARES PEQUENOS
========================================= */

@media (max-width: 560px) {
    header {
        padding-left: 5%;
        padding-right: 5%;
    }

    .logo {
        font-size: 22px;
    }

    .header-button {
        padding: 10px 16px;
        font-size: 13px;
    }

    .hero,
    .showcase,
    .features,
    .experience,
    .about,
    .cta,
    footer {
        padding-left: 5%;
        padding-right: 5%;
    }

    .hero {
        padding-top: 70px;
        padding-bottom: 70px;
    }

    .hero h1 {
        font-size: 44px;
    }

    .hero-buttons {
        flex-direction: column;
        width: 100%;
    }

    .button-primary {
        width: 100%;
        text-align: center;
    }

    .hero-image img,
    .experience-image img {
        height: 340px;
        border-radius: 25px;
    }

    .showcase-image img {
        height: 300px;
        border-radius: 24px;
    }

    .feature-card {
        padding: 32px;
        border-radius: 28px;
    }

    .feature-number {
        margin-bottom: 55px;
    }

    .about h2,
    .cta h2,
    .showcase h2,
    .section-heading h2 {
        letter-spacing: -1.5px;
    }

    .section-description,
    .about-description {
        font-size: 16px;
    }
}

/* =========================================
   ACESSIBILIDADE — REDUÇÃO DE MOVIMENTO
========================================= */

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}
